# For local testing / Coolify environment variables
PORT=3000

# Use your self-hosted Supabase Postgres connection string.
# Example (internal container networking):
# DATABASE_URL=postgresql://postgres:<password>@supabase-db:5432/postgres
DATABASE_URL=DATABASE_URL=postgresql://postgres:<YOUR_POSTGRES_PASSWORD>@127.0.0.1:5432/postgres

# Optional: set true only if your Postgres endpoint requires TLS
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
