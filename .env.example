# For local testing / Coolify environment variables
PORT=3000

# Use your self-hosted Supabase Postgres connection string.
# DATABASE_URL should point to the pooled (pgBouncer) connection.
DATABASE_URL=postgresql://postgres:<YOUR_POSTGRES_PASSWORD>@host.docker.internal:6543/postgres?pgbouncer=true

# DIRECT_URL should point to the direct Postgres connection.
DIRECT_URL=postgresql://postgres:<YOUR_POSTGRES_PASSWORD>@host.docker.internal:5432/postgres

# Optional: set true only if your Postgres endpoint requires TLS
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
